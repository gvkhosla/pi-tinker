{
  "name": "pi-tinker",
  "version": "0.9.5",
  "description": "Run and fine-tune Inkling-Small, Inkling, and other open-weight models with Tinker from Pi: effort sweeps, evals, SFT scaffolding, checkpoint chat, and Cookbook export/serving plans.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/gvkhosla/pi-tinker#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gvkhosla/pi-tinker.git"
  },
  "bugs": {
    "url": "https://github.com/gvkhosla/pi-tinker/issues"
  },
  "keywords": [
    "pi-package",
    "tinker",
    "fine-tuning",
    "post-training",
    "llm",
    "sft",
    "rl",
    "dpo",
    "inkling",
    "coding-agent",
    "claude-code",
    "cursor"
  ],
  "type": "module",
  "bin": {
    "pi-tinker-agent": "./scripts/agent-cli.mjs"
  },
  "files": [
    "extensions/",
    "skills/",
    "docs/",
    "examples/",
    "scripts/",
    "README.md",
    "AGENTS.md",
    "CLAUDE.md",
    "GEMINI.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "npm run smoke-test && npm run local-integration-test",
    "smoke-test": "node scripts/smoke-test.mjs",
    "local-integration-test": "node scripts/local-integration-test.mjs"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  }
}
